import React, { useState } from 'react';
import {
  ShieldCheck,
  Plus,
  Trash2,
  Edit3,
} from 'lucide-react';
import { useApp } from '../context/AppContext';
import { SafetyMap } from '../components/Map/SafetyMap';
import { evaluateGeofence, formatCoordinates } from '../utils/geoUtils';

export const SafeZonesView: React.FC = () => {
  const {
    selectedChild,
    safeZones,
    addSafeZone,
    updateSafeZone,
    deleteSafeZone,
    getCurrentReading,
    getChildGeofenceStatus,
    referenceLocations,
  } = useApp();

  const [isAdding, setIsAdding] = useState(false);
  const [editingZoneId, setEditingZoneId] = useState<string | null>(null);

  const [zoneForm, setZoneForm] = useState({
    name: 'School Campus Safe Zone',
    centerLat: selectedChild?.schoolLat || 9.92810,
    centerLng: selectedChild?.schoolLng || 78.12350,
    radiusMeters: 250,
    isActive: true,
  });

  if (!selectedChild) {
    return <div className="p-8 text-center text-xs text-gray-500">No child selected.</div>;
  }

  const childZones = safeZones.filter((sz) => sz.childId === selectedChild.id);
  const currentReading = getCurrentReading(selectedChild.id);
  const geofence = getChildGeofenceStatus(selectedChild.id);

  const handleSave = (e: React.FormEvent) => {
    e.preventDefault();
    if (editingZoneId) {
      updateSafeZone(editingZoneId, zoneForm);
      setEditingZoneId(null);
    } else {
      addSafeZone({
        childId: selectedChild.id,
        name: zoneForm.name,
        centerLat: zoneForm.centerLat,
        centerLng: zoneForm.centerLng,
        radiusMeters: zoneForm.radiusMeters,
        isActive: true,
      });
      setIsAdding(false);
    }
  };

  const handleMapClick = (lat: number, lng: number) => {
    if (isAdding || editingZoneId) {
      setZoneForm((prev) => ({
        ...prev,
        centerLat: parseFloat(lat.toFixed(5)),
        centerLng: parseFloat(lng.toFixed(5)),
      }));
    }
  };

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 className="text-xl font-bold tracking-tight text-[#111827]">
            Geofencing &amp; Safe Zones
          </h2>
          <p className="text-xs text-gray-500 mt-0.5">
            Configure virtual geographic boundaries evaluated via the spherical Haversine formula.
          </p>
        </div>

        {!isAdding && (
          <button
            onClick={() => {
              setIsAdding(true);
              setEditingZoneId(null);
              setZoneForm({
                name: 'Designated Safe Zone',
                centerLat: currentReading?.latitude || selectedChild.homeLat,
                centerLng: currentReading?.longitude || selectedChild.homeLng,
                radiusMeters: 200,
                isActive: true,
              });
            }}
            className="bg-[#3B82F6] hover:bg-blue-600 text-white text-xs font-bold px-4 py-2 rounded-md flex items-center gap-1.5 transition-colors cursor-pointer self-start sm:self-auto"
          >
            <Plus className="w-4 h-4" />
            <span>Add New Safe Zone</span>
          </button>
        )}
      </div>

      {/* Geofence Status Callout Card */}
      <div className={`p-4 rounded-lg border flex flex-col sm:flex-row sm:items-center justify-between gap-4 ${
        geofence.state === 'IN_SAFE_ZONE'
          ? 'bg-emerald-50 border-emerald-200 text-emerald-950'
          : 'bg-red-50 border-red-200 text-red-950'
      }`}>
        <div className="flex items-center gap-3">
          <div className={`w-10 h-10 rounded-full flex items-center justify-center font-bold ${
            geofence.state === 'IN_SAFE_ZONE' ? 'bg-emerald-200 text-emerald-800' : 'bg-red-200 text-red-800'
          }`}>
            <ShieldCheck className="w-5 h-5" />
          </div>
          <div>
            <div className="text-xs font-bold uppercase tracking-wider text-gray-600">
              Active Geofence State for {selectedChild.name}
            </div>
            <div className="text-base font-extrabold mt-0.5">
              {geofence.state === 'IN_SAFE_ZONE' ? 'IN SAFE ZONE (NORMAL)' : 'OUTSIDE SAFE ZONE (PERIMETER BREACH)'}
            </div>
          </div>
        </div>

        <div className="text-xs sm:text-right font-medium">
          <div>Boundary: <strong>{geofence.zoneName}</strong></div>
          <div className="text-gray-600">Haversine Distance: <strong>{geofence.distanceMeters}m</strong> from center</div>
        </div>
      </div>

      {/* Add / Edit Form Modal / Panel */}
      {(isAdding || editingZoneId) && (
        <div className="bg-white border border-[#E5E7EB] rounded-lg p-5">
          <div className="flex items-center justify-between pb-3 border-b border-[#E5E7EB] mb-4">
            <h3 className="text-sm font-bold text-[#111827]">
              {editingZoneId ? 'Modify Safe Zone Boundary' : 'Create New Circular Safe Zone'}
            </h3>
            <button
              onClick={() => {
                setIsAdding(false);
                setEditingZoneId(null);
              }}
              className="text-xs text-gray-500 hover:text-gray-800"
            >
              Cancel
            </button>
          </div>

          <form onSubmit={handleSave} className="space-y-4">
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              <div>
                <label className="block text-xs font-semibold text-gray-700 mb-1">
                  Zone Name
                </label>
                <input
                  type="text"
                  value={zoneForm.name}
                  onChange={(e) => setZoneForm({ ...zoneForm, name: e.target.value })}
                  placeholder="e.g. School Perimeter"
                  className="w-full text-xs p-2.5 rounded-md border border-[#E5E7EB] bg-white focus:outline-none focus:border-blue-500"
                />
              </div>

              <div>
                <label className="block text-xs font-semibold text-gray-700 mb-1">
                  Radius: <span className="font-bold text-blue-700">{zoneForm.radiusMeters} meters</span>
                </label>
                <input
                  type="range"
                  min="50"
                  max="1000"
                  step="25"
                  value={zoneForm.radiusMeters}
                  onChange={(e) => setZoneForm({ ...zoneForm, radiusMeters: parseInt(e.target.value) })}
                  className="w-full mt-2"
                />
              </div>

            </div>

            <div className="flex items-center justify-between pt-3 border-t border-[#E5E7EB]">
              <span className="text-[11px] text-gray-500">
                Click the map or drag the green pin to position the safe-zone center. The circle is a preview until saved.
              </span>
              <button
                type="submit"
                className="bg-[#3B82F6] hover:bg-blue-600 text-white text-xs font-bold px-4 py-2 rounded-md cursor-pointer"
              >
                {editingZoneId ? 'Save Changes' : 'Confirm Safe Zone'}
              </button>
            </div>
          </form>
        </div>
      )}

      {/* Main Map Visualization */}
      <div className="bg-white p-4 rounded-lg border border-[#E5E7EB]">
        <div className="flex items-center justify-between mb-3">
          <div>
            <h3 className="text-sm font-bold text-[#111827]">
              Geofence Radius Visualization
            </h3>
            <p className="text-xs text-gray-500">
              {isAdding || editingZoneId ? 'Click to move the center or drag the green pin. Green circle previews the boundary.' : 'Green circle represents the configured safe-zone boundary.'}
            </p>
          </div>
          <span className="text-xs font-semibold text-gray-600">
            Center: {formatCoordinates((isAdding || editingZoneId ? zoneForm.centerLat : childZones[0]?.centerLat) ?? 9.9281, (isAdding || editingZoneId ? zoneForm.centerLng : childZones[0]?.centerLng) ?? 78.1235)}
          </span>
        </div>

        <SafetyMap
          currentLat={currentReading?.latitude || childZones[0]?.centerLat || 9.9281}
          currentLng={currentReading?.longitude || childZones[0]?.centerLng || 78.1235}
          childName={selectedChild.name}
          isSimulated={currentReading?.isSimulated}
          safeZone={childZones[childZones.length - 1]}
          previewSafeZone={(isAdding || editingZoneId) ? { ...zoneForm, isActive: true } : undefined}
          draggableSafeZonePin={Boolean(isAdding || editingZoneId)}
          riskZones={referenceLocations.filter((r) => r.type === 'risk_zone')}
          onMapClick={handleMapClick}
          heightClass="h-[400px]"
        />
      </div>

      {/* List of Configured Safe Zones */}
      <div className="bg-white rounded-lg border border-[#E5E7EB] overflow-hidden">
        <div className="p-4 border-b border-[#E5E7EB]">
          <h3 className="text-sm font-bold text-[#111827]">Configured Safe Zones</h3>
        </div>

        <div className="divide-y divide-[#E5E7EB]">
          {childZones.map((zone) => {
            const dist = currentReading
              ? evaluateGeofence(currentReading.latitude, currentReading.longitude, zone.centerLat, zone.centerLng, zone.radiusMeters)
              : null;

            return (
              <div key={zone.id} className="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-gray-50">
                <div>
                  <div className="flex items-center gap-2">
                    <h4 className="text-sm font-bold text-[#111827]">{zone.name}</h4>
                    <span className={`text-[10px] font-bold px-2 py-0.5 rounded ${
                      zone.isActive ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-600'
                    }`}>
                      {zone.isActive ? 'ACTIVE' : 'DISABLED'}
                    </span>
                  </div>
                  <div className="text-xs text-gray-500 mt-1 flex flex-wrap gap-x-4">
                    <span>Center: <strong className="font-mono">{zone.centerLat.toFixed(5)}, {zone.centerLng.toFixed(5)}</strong></span>
                    <span>Radius: <strong>{zone.radiusMeters}m</strong></span>
                    {dist && (
                      <span>Current Distance: <strong>{dist.distanceMeters}m ({dist.isInside ? 'Inside' : 'Outside'})</strong></span>
                    )}
                  </div>
                </div>

                <div className="flex items-center gap-2">
                  <button
                    onClick={() => {
                      setEditingZoneId(zone.id);
                      setIsAdding(false);
                      setZoneForm({
                        name: zone.name,
                        centerLat: zone.centerLat,
                        centerLng: zone.centerLng,
                        radiusMeters: zone.radiusMeters,
                        isActive: zone.isActive,
                      });
                    }}
                    className="p-1.5 text-gray-600 hover:text-blue-600 hover:bg-blue-50 rounded cursor-pointer"
                    title="Edit Zone"
                  >
                    <Edit3 className="w-4 h-4" />
                  </button>
                  {childZones.length > 1 && (
                    <button
                      onClick={() => {
                        if (confirm(`Delete safe zone "${zone.name}"?`)) {
                          deleteSafeZone(zone.id);
                        }
                      }}
                      className="p-1.5 text-gray-600 hover:text-red-600 hover:bg-red-50 rounded cursor-pointer"
                      title="Delete Zone"
                    >
                      <Trash2 className="w-4 h-4" />
                    </button>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
};

